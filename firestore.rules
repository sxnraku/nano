rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function isValidStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidNumber(field) {
      return request.resource.data[field] is number;
    }

    function isValidTimestamp(field) {
      return request.resource.data[field] is timestamp;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser() {
      return hasRequiredFields(['uid', 'displayName', 'totalWins', 'collectionSize']) &&
             isValidStringLength('displayName', 1, 50) &&
             isValidNumber('totalWins') &&
             isValidNumber('collectionSize') &&
             (!('highestCombo' in request.resource.data) || isValidNumber('highestCombo')) &&
             (!('photoURL' in request.resource.data) || isValidStringLength('photoURL', 0, 500)) &&
             (!('guildId' in request.resource.data) || request.resource.data.guildId == null || request.resource.data.guildId is string);
    }

    function isValidChallenge() {
      return hasRequiredFields(['creatorId', 'warriorData', 'createdAt']) &&
             request.resource.data.creatorId == request.auth.uid &&
             isValidStringLength('warriorData', 1, 100000) &&
             isValidTimestamp('createdAt');
    }

    function isValidGuild() {
      return hasRequiredFields(['name', 'leaderId', 'members', 'totalTrophies']) &&
             isValidStringLength('name', 3, 30) &&
             isValidNumber('members') &&
             isValidNumber('totalTrophies');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser();
      // Relaxed update slightly to allow claiming quests and joining guilds (assuming trusting client for MVP quests)
      allow update: if isOwner(userId) && isValidUser() && uidNotModified() && 
                    (request.resource.data.totalWins <= resource.data.totalWins + 1);
      allow delete: if false;
    }

    match /guilds/{guildId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidGuild() && request.resource.data.leaderId == request.auth.uid;
      // Allow joining/increasing members and adding trophies
      allow update: if isAuthenticated() && isValidGuild() && 
                    (request.resource.data.members <= resource.data.members + 1) &&
                    (request.resource.data.totalTrophies >= resource.data.totalTrophies);
      allow delete: if isAuthenticated() && resource.data.leaderId == request.auth.uid;
    }

    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidChallenge();
      allow update: if isAuthenticated() && 
                    request.resource.data.creatorId == resource.data.creatorId && 
                    request.resource.data.warriorData == resource.data.warriorData &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    (request.resource.data.wins <= resource.data.wins + 1) &&
                    (request.resource.data.losses <= resource.data.losses + 1) &&
                    isValidChallenge();
      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }

    match /matchmaking/{id} {
      allow read, update, delete: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    match /pvp_battles/{id} {
      allow read, update, delete: if isAuthenticated();
      allow create: if isAuthenticated();
    }
  }
}
